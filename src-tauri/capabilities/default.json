{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "core:path:default",
        {
            "identifier": "core:event:allow-listen",
            "allow": [{ "event": "tasks-reset" }]
        },
        {
            "identifier": "core:event:allow-emit",
            "allow": [{ "event": "tasks-reset" }]
        }
    ]
}
