{{! prettier-ignore }}
{
  "licenses": [
    {{#each licenses}}
      {{#each used_by}}
      {
        "id": "{{{crate.name}}}@{{{crate.version}}}",
        "name": {{{json ../name}}},
        "version": {{{json crate.version}}},
        "author": "",
        "repository": {{{json crate.repository}}},
        "license_text": {{{json ../text}}},
        "source": "cargo"
      }{{#unless (and @last @../last)}},{{/unless}}
      {{/each}}
    {{/each}}
  ]
}