{{! prettier-ignore }}
[
  {{#each licenses}}
    {{#each used_by}}
    {
      "name": {{{json crate.name}}},
      "version": {{{json crate.version}}},
      "license_id": {{{json ../name}}},
      "authors": {{{json crate.authors}}},
      "repository": {{{json crate.repository}}},
      "text": {{{json ../text}}}
    }{{#unless (and @last @../last)}},{{/unless}}
    {{/each}}
  {{/each}}
]